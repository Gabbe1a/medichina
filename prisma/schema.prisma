generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Service {
  id             String    @id @default(cuid())
  slug           String    @unique
  path           String    @unique
  title          String
  description    String    @default("")
  seoTitle       String    @default("")
  seoDescription String    @default("")
  parentId       String?
  parent         Service?  @relation("ServiceTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Service[] @relation("ServiceTree")
  topSlug        String
  published      Boolean   @default(true)
  sortOrder      Int       @default(0)
  prices         PriceItem[]
}

model PriceItem {
  id           String   @id @default(cuid())
  title        String
  price        Int
  unit         String   @default("₽")
  categoryName String
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  code         String   @default("")
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
}

model Doctor {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String
  specialty   String   @default("")
  experience  String   @default("")
  education   String   @default("")
  bio         String   @default("")
  photoUrl    String
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
}

model Review {
  id        String  @id @default(cuid())
  author    String
  dateLabel String  @default("")
  rating    Int     @default(5)
  text      String
  published Boolean @default(true)
  sortOrder Int     @default(0)
}

model Page {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  excerpt   String  @default("")
  body      String
  published Boolean @default(true)
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  published Boolean @default(true)
  sortOrder Int     @default(0)
}

model Setting {
  id            String @id @default("site")
  brand         String
  legalEntity   String
  address       String
  metro         String
  phone1        String
  phone2        String
  email         String
  hours         String
  whatsapp      String
  yandexOrgId   String
  lon           Float
  lat           Float
  rating        Float
  reviewsCount  Int
  ratingsCount  Int
  license       String
  ogrn          String
  metrika       String
  howToGet      String
  receptionNote String @default("")
}

model GalleryImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("Фото клиники «Один к Одному»")
  published Boolean @default(true)
  sortOrder Int     @default(0)
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String   @default("")
  message   String   @default("")
  source    String   @default("consultation")
  createdAt DateTime @default(now())
}
